# Force Linguist to correctly categorize the backend as Python
backend/**/* linguist-language=Python
# Classify all frontend style and script files correctly
*.css linguist-language=CSS
*.js linguist-language=JavaScript
*.html linguist-language=HTML
# Optionally, ensure key files like 'requirements.txt' are seen as part of a Python project
requirements.txt linguist-detectable
Procfile linguist-detectable