    "url": "https://github.com/YOUR_USERNAME/soil-health-website/issues"
  },
  "homepage": "https://YOUR_USERNAME.github.io/soil-health-website",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
