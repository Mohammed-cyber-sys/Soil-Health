{
  "name": "soil-health-website",
  "version": "1.0.0",
  "description": "AI-Powered Soil Health Analysis Platform",
  "main": "frontend/index.html",
  "scripts": {
    "start": "cd backend && python app.py",
    "dev:backend": "cd backend && python app.py",
    "dev:frontend": "cd frontend && python -m http.server 8000",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "install:backend": "cd backend && pip install -r requirements.txt",
    "deploy:backend": "cd backend && echo 'Follow Railway/Render deployment instructions'",
    "test": "echo 'No tests specified'",
    "build": "echo 'No build step required for static site'",
    "lint": "echo 'No linting configured'"
  },
  "keywords": [
    "agriculture",
    "soil-health",
    "ai",
    "farming",
    "sustainability"
  ],
